{
  "name": "lazypush",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "lazypush": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build --compile --minify src/index.tsx --outfile dist/lazypush",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentui/solid": "latest",
    "firebase-admin": "^13",
    "solid-js": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "bun-types": "^1.3.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "ultracite": "7.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  }
}
